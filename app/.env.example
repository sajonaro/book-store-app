# ── PostgreSQL ─────────────────────────────────────────────────────────────────
POSTGRES_USER=bookstore
POSTGRES_PASSWORD=changeme_strong_password_here
POSTGRES_DB=bookstore

# ── Elasticsearch ──────────────────────────────────────────────────────────────
ELASTIC_URL=http://elastic:9200

# ── OpenAI (used by ai-api for book photo recognition) ────────────────────────
# The key is read from app/ai-api/credentials/openai_key.txt inside the container.
# You can also set it here and it will be passed as an environment variable.
OPENAI_API_KEY=sk-...

# ── AI API ─────────────────────────────────────────────────────────────────────
# Internal Docker URL used by the backend container
AI_API_URL=http://ai-api:8000
# Port exposed to the host — used by test-samples.sh for end-to-end testing
AI_API_PORT=8000

# ── Backend ────────────────────────────────────────────────────────────────────
PORT=5555
ALLOWED_ORIGINS=http://localhost:8081
NODE_ENV=production

# ── Frontend ───────────────────────────────────────────────────────────────────
FRONTEND_PORT=8081
