# ── PostgreSQL ─────────────────────────────────────────────────────────────────
POSTGRES_USER=bookstore
POSTGRES_PASSWORD=changeme_strong_password_here
POSTGRES_DB=bookstore

# ── Elasticsearch ──────────────────────────────────────────────────────────────
ELASTIC_URL=http://elastic:9200

# ── Public base URL (used for QR code deep-links) ─────────────────────────────
# Set to your publicly reachable URL (e.g. https://bookstore.example.com)
PUBLIC_BASE_URL=http://localhost:8081

# ── AI API ─────────────────────────────────────────────────────────────────────
# Internal Docker URL used by the backend container
AI_API_URL=http://ai-api:8000
# Port exposed to the host — used by test-samples.sh for end-to-end testing
AI_API_PORT=8000

# ── Backend ────────────────────────────────────────────────────────────────────
PORT=5555
ALLOWED_ORIGINS=http://localhost:8081
NODE_ENV=production

# ── Superuser (system admin above all tenants) ────────────────────────────────
# Set these to seed the initial superuser on first backend start.
# The superuser can log in without a tenant slug and sees ALL books across tenants.
SUPERUSER_EMAIL=admin@system.local
SUPERUSER_PASSWORD=change_me_strong_password_here
SUPERUSER_NAME=System Admin

# ── Frontend ───────────────────────────────────────────────────────────────────
FRONTEND_PORT=8081
