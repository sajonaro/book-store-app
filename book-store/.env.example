# ── MongoDB ────────────────────────────────────────────────────────────────────
# Root credentials for the MongoDB container
MONGO_ROOT_USER=admin
MONGO_ROOT_PASSWORD=changeme_strong_password_here
MONGO_DB=bookstore

# ── Frontend ───────────────────────────────────────────────────────────────────
# Host port the nginx frontend will be exposed on
FRONTEND_PORT=8080
